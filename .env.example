# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=                 # the Lava server (models get a private category inside it)
# Everything below in this block is OPTIONAL. The guild owner is automatically admin+owner; the bot creates the
# STAFF / AGENCY channels itself on first boot and remembers their ids. Use /owners add @user for Marissa.
BOT_ADMIN_IDS=                    # extra admins (comma-separated user ids)
OWNER_IDS=                        # extra owners
STAFF_LIVE_ALERTS_CHANNEL_ID=     # override only if you want to reuse an existing channel
STAFF_REQUESTS_INBOX_CHANNEL_ID=
STAFF_REELS_INBOX_CHANNEL_ID=
STAFF_OPS_LOG_CHANNEL_ID=
AGENCY_LOUNGE_CHANNEL_ID=

# ── Claude ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5    # chat, rewrites, captions
CLAUDE_VISION_MODEL=claude-sonnet-4-5

# ── Notion (optional mirror of all state) ──────────────────────────────────
NOTION_TOKEN=
NOTION_DB_MODELS=
NOTION_DB_LIVE_SESSIONS=
NOTION_DB_WEEKLY_METRICS=
NOTION_DB_CONTENT_REQUESTS=
NOTION_DB_REELS_BOARD=
NOTION_DB_POSTS=

# ── Google Drive (service account JSON, base64) ────────────────────────────
GOOGLE_SERVICE_ACCOUNT_B64=
DRIVE_ROOT_FOLDER_ID=             # "Lava Content" shared drive root

# ── Apify (reels sourcing) ─────────────────────────────────────────────────
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper

# ── Zernio (auto-posting) ──────────────────────────────────────────────────
ZERNIO_API_KEY=

# ── Runtime ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction" (port 6543). Local dev: postgres://postgres:postgres@localhost:5432/lava
DATABASE_URL=
REGISTER_COMMANDS_ON_BOOT=true   # set false only if you register commands by hand
LOG_LEVEL=info
DEFAULT_TIMEZONE=America/New_York

# GitHub write access so /model add can commit models/<slug>/ (fine-grained PAT, Contents: read/write, this repo only)
GITHUB_TOKEN=
GITHUB_REPO=dcuesta717/Lava-Discord-Bot
GITHUB_BRANCH=main
