# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=                 # the Lava server (models get a private category inside it)
BOT_ADMIN_IDS=                    # comma-separated Discord user ids (Dan)
OWNER_IDS=                        # comma-separated (Dan, Marissa) — get live alerts + request pings
STAFF_LIVE_ALERTS_CHANNEL_ID=     # #live-alerts (staff-only)
STAFF_REQUESTS_INBOX_CHANNEL_ID=  # #content-requests-inbox
STAFF_REELS_INBOX_CHANNEL_ID=     # #reels-inbox (manual URL drops)
STAFF_OPS_LOG_CHANNEL_ID=         # #ops-log
AGENCY_LOUNGE_CHANNEL_ID=         # #agency-lounge (all models + owners)

# ── Claude ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5    # chat, rewrites, captions
CLAUDE_VISION_MODEL=claude-sonnet-4-5

# ── Notion (optional mirror of all state) ──────────────────────────────────
NOTION_TOKEN=
NOTION_DB_MODELS=
NOTION_DB_LIVE_SESSIONS=
NOTION_DB_WEEKLY_METRICS=
NOTION_DB_CONTENT_REQUESTS=
NOTION_DB_REELS_BOARD=
NOTION_DB_POSTS=

# ── Google Drive (service account JSON, base64) ────────────────────────────
GOOGLE_SERVICE_ACCOUNT_B64=
DRIVE_ROOT_FOLDER_ID=             # "Lava Content" shared drive root

# ── Apify (reels sourcing) ─────────────────────────────────────────────────
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper

# ── Zernio (auto-posting) ──────────────────────────────────────────────────
ZERNIO_API_KEY=

# ── Runtime ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction" (port 6543). Local dev: postgres://postgres:postgres@localhost:5432/lava
DATABASE_URL=
LOG_LEVEL=info
DEFAULT_TIMEZONE=America/New_York
